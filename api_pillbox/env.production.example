# Plantilla de variables de entorno para PRODUCCIÓN (Oracle Cloud).
#
# NO copies aquí los valores de tu .env de desarrollo (contraseña "0000",
# claves VAPID de prueba, etc). Genera credenciales nuevas para el servidor.
#
# Pasos en la VM:
#   1. cp .env.production.example .env
#   2. Rellena cada valor.
#   3. Genera una SECRET_KEY nueva:
#      docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ---
SECRET_KEY=
DEBUG=False
PAGE_SIZE=10

# Dominio(s) público(s) que apuntan a esta VM, separados por coma.
# Ejemplo con DuckDNS: pillbox2026.duckdns.org
ALLOWED_HOSTS=TU_DOMINIO_AQUI

# --- Base de datos (el contenedor "db" del docker-compose, host = db) ---
DB_NAME=pillbox_db
DB_USER=pillbox_user
DB_PASSWORD=GENERA_UNA_CONTRASENA_FUERTE_AQUI
DB_HOST=db
DB_PORT=5432

# --- CORS / CSRF: dominios desde donde el frontend/app llamará a la API ---
# Incluye el origen de tu APK (Capacitor usa "https://localhost" o un esquema
# personalizado; ajusta según cómo generes el build) y, si sigues probando el
# front en Angular local, los orígenes de localhost:4200.
CORS_ALLOWED_ORIGINS=https://TU_DOMINIO_AQUI,http://localhost:4200,http://127.0.0.1:4200

# --- Web Push (VAPID) ---
# Puedes reutilizar las mismas claves VAPID del entorno de desarrollo si ya
# las generaste, o crear unas nuevas con: python -m pywebpush.vapid
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:tu-correo@dominio.com

# --- Correo saliente (verificación de cuenta / invitaciones) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Gunicorn ---
GUNICORN_WORKERS=3

# No definas RUN_INPROCESS_SCHEDULER aquí: con DEBUG=False queda apagado por
# defecto, que es lo correcto en producción. El envío de notificaciones va
# por el cron externo (ver deploy/README-deploy.md).
