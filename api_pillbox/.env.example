# ==============================================================================
# CONFIGURACIÓN DE ENTORNO (EJEMPLO)
# ==============================================================================
# Copia este archivo a `.env` y configura los valores correspondientes.
# NUNCA subas el archivo `.env` al control de versiones.

# Clave secreta de Django (OBLIGATORIA, no tiene valor por defecto).
# Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Nunca reutilices la clave de ejemplo de este archivo ni la subas a git.
SECRET_KEY=

# Modo depuración (True / False). Debe ser False en cualquier entorno
# accesible fuera de localhost (incluidos túneles temporales tipo devtunnels).
DEBUG=False

# Elementos por página en medicamentos, horarios y registros
PAGE_SIZE=10

# Hosts permitidos (separados por comas). NO usar '*' cuando DEBUG=False:
# lista explícitamente cada host/dominio/túnel que sirva la API.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Configuración de Base de Datos PostgreSQL
DB_NAME=pillbox_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Orígenes CORS permitidos para clientes Frontend (Angular, etc.) separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Scheduler en memoria de notificaciones push (APScheduler). Solo pensado
# para `runserver` en desarrollo local (se activa solo si DEBUG=True, salvo
# que se fuerce aquí). En producción con gunicorn/uwsgi NO lo actives: cada
# worker arrancaría su propio scheduler y duplicaría los pushes. Usa en su
# lugar un cron/systemd timer de un solo proceso que ejecute
# `python manage.py enviar_notificaciones` cada minuto.
# RUN_INPROCESS_SCHEDULER=False
