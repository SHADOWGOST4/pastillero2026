# Copiar como <proyecto-android>/android/keystore.properties (junto a gradlew)
# y rellenar. Ese archivo NUNCA se commitea (esta en .gitignore).
#
# Ojo: en .properties la barra invertida es caracter de escape. En Windows usa
# barras normales en la ruta: C:/Users/... (no C:\Users\...).
storeFile=C:/Users/TU_USUARIO/keystores/epillbox-release.jks
storePassword=ESCRIBE_AQUI_LA_CONTRASENA_DEL_KEYSTORE
keyAlias=epillbox
keyPassword=ESCRIBE_AQUI_LA_CONTRASENA_DE_LA_CLAVE
